---
import { Image } from 'astro:assets';
import logo from '../assets/h1_logo.png';
import { nav, site } from '../data/site';
---

<header class="header">
  <h1 class="header__logo">
    <a href="#top">
      <Image src={logo} alt="AONO STUDIO" height={40} densities={[1, 2]} loading="eager" />
    </a>
  </h1>
  <nav class="header__nav" aria-label="メイン">
    {
      nav.map((item) => (
        <a href={item.href}>
          {item.en}
          <span class="visually-hidden">{item.ja}</span>
        </a>
      ))
    }
  </nav>
  <button
    class="header__menu"
    type="button"
    aria-expanded="false"
    aria-controls="menu-panel"
    aria-label="メニュー"
  >
    <span class="header__lines" aria-hidden="true">
      <span></span>
      <span></span>
    </span>
  </button>
</header>

<nav id="menu-panel" class="menu" aria-label="メニュー" aria-hidden="true" inert>
  <ul class="menu__list">
    {
      nav.map((item) => (
        <li>
          <a href={item.href}>
            <span class="menu__en">{item.en}</span>
            <span class="menu__ja">{item.ja}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="menu__phone">
    <a href={`tel:${site.phones[0].tel}`}>{site.phones[0].display}</a>
  </p>
</nav>

<style lang="scss">
  .header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: var(--header-h);
    padding: 0 var(--page-pad);
    background: $ink;
    border-bottom: 1px solid rgba($paper, 0.16);
  }

  .header__logo {
    line-height: 0;

    a {
      display: flex;
      align-items: center;
    }

    img {
      height: 40px;
      width: auto;
      filter: brightness(0) invert(1);
    }
  }

  .header__nav {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);

    a {
      position: relative;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;

      &::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1px;
        background: $paper;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.4s ease;
      }

      &:hover::after,
      &:focus-visible::after {
        transform: scaleX(1);
      }
    }
  }

  .header__menu {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .header__lines {
    position: relative;
    display: block;
    width: 22px;
    height: 10px;

    span {
      position: absolute;
      left: 0;
      width: 22px;
      height: 1px;
      background: $paper;
      transform-origin: center;

      &:first-child {
        top: 0;
      }

      &:last-child {
        bottom: 0;
      }
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--header-h) + 2.5rem) var(--page-pad) 2rem;
    background: $ink;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    pointer-events: none;
  }

  .menu.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .menu__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.35rem 0;
    text-decoration: none;
  }

  .menu__en {
    font-family: $mincho;
    font-size: clamp(3rem, 12vw, 5rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .menu__ja {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
  }

  .menu__phone {
    margin: 0;
    font-family: $serif;
    font-size: 1.5rem;
    line-height: 1.4;

    a {
      text-decoration: none;
    }
  }

  @include tablet {
    .header__nav {
      display: none;
    }

    .header__menu {
      display: inline-flex;
    }

    .header__logo img {
      height: 32px;
    }
  }
</style>
