---
import { site } from '../data/site';

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&hl=ja&z=16&output=embed`;
---

<section class="access" id="access">
  <div class="access__copy">
    <p class="access__label">Access</p>
    <h2>アクセス</h2>
    <address class="access__address">
      <p class="access__line">{site.postal}</p>
      <p class="access__line">{site.address[0]}</p>
      <p class="access__line">{site.address[1]}</p>
    </address>
    <p class="access__line access__station">{site.access}</p>
    <div class="access__hours">
      <p class="access__line">{site.hours}</p>
      <p class="access__line access__closed">{site.closed} 定休</p>
    </div>
  </div>
  <div class="access__map" data-lenis-prevent-touch>
    <iframe title="AONO STUDIO の地図" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</section>

<style lang="scss">
  .access {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    min-height: 80vh;
    background: $ink;
    scroll-margin-top: var(--header-h);
  }

  .access__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem var(--page-pad);
  }

  .access__label {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .access h2 {
    margin: 0.4rem 0 0;
    font-family: $mincho;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .access__address {
    margin: 2rem 0 0;

    p {
      margin: 0;
      font-family: $mincho;
      font-size: clamp(1.5rem, 2.4vw, 2.15rem);
      font-weight: 500;
      line-height: 1.55;
    }
  }

  .access__station {
    margin: 1.25rem 0 0;
    color: $mute;
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  .access__hours {
    margin-top: 2rem;

    p {
      margin: 0;
      line-height: 1.8;
    }
  }

  .access__closed {
    color: $rust;
  }

  .access__map {
    min-height: 100%;

    iframe {
      width: 100%;
      height: 100%;
      min-height: 80vh;
      border: 0;
      filter: grayscale(1) contrast(1.05);
      transition: filter 0.4s ease;
    }

    &:hover iframe {
      filter: none;
    }
  }

  @include tablet {
    .access {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .access__copy {
      padding: 4rem var(--page-pad) 2.5rem;
    }

    .access__map iframe {
      height: 280px;
      min-height: 280px;
    }
  }
</style>
